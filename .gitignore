# Bulk inputs and build output. All of it is reproducible:
#   scripts/fetch_sources.sh --archives
#   python -m tbacss build / analyze / publish
*.tar.gz
tbacss.db
tbacss.db-wal
tbacss.db-shm
web/data/
web/fixture/

# TBAC's own material, fetched rather than vendored: the report pages are
# their copyrighted document rather than the data they grant use of, and
# reference/ is their Octave, which carries an ALL RIGHTS RESERVED header.
# Neither is needed to build -- tbacss/analysis.py is an independent port --
# and scripts/fetch_sources.sh puts both back. The all.csv tables next to the
# reports are data and are tracked.
summit*/index.html
reference/

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
